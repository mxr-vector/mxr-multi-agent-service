# 页面标题
VITE_APP_TITLE = 多智能体前端测试

# 预发布环境配置
VITE_APP_ENV = 'staging'

# 预发布环境端口    
VITE_APP_PORT = 80

# 若依管理系统/预发布环境 - 代理前缀
VITE_APP_BASE_API = /stage-api

# 后端服务地址（代理目标）
VITE_API_BASE_URL = http://127.0.0.1:8000/multi-agent-service

# 接口鉴权密钥（对应后端 API_SECRET_KEY，请求头以 Bearer 形式注入）
VITE_APP_TOKEN = MXR-MULTI-AGENT-SERVICE

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip