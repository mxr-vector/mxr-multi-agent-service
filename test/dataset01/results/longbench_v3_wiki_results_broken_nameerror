        {
          "document_id": "01a013d1fbab7dc6a7aad21ca70bcb86",
          "score": 0.7033562064170837,
          "text": "Maria Isabel de Alcântara, Countess of Iguaçu\nMaria Isabel de Alcântara Bourbon (28 February 1830 – 5 September 1896) was the third daughter (fifth child) of emperor Pedro I of Brazil and his mistress, Domitila de Castro, Marchioness of Santos.",
          "source_hops": [
            0
