        {
          "document_id": "01a013c3a8717d27a8eacb2bab27f5da",
          "score": 0.6577873229980469,
          "text": "Keōpūolani\nKalanikauikaʻalaneo Kai Keōpūolani-Ahu-i-Kekai-Makuahine-a-Kama-Kalani-Kau-i-Kealaneo (1778–1823) was a queen consort of Hawaiʻi and the highest ranking wife of King Kamehameha I.",
          "source_hops": [
            0
