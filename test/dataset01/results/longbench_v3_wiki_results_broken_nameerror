            0
          ]
        },
        {
          "document_id": "01a01786859879f1a03708cefae48b90",
          "score": 0.629347562789917,
          "text": "List of Back to the Future characters\nMarty Jr. and Marlene McFly (both portrayed by Michael J. Fox) are Marty McFly and Jennifer Parker's future son and daughter in 2015 in Part II.",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a017867ecc71b4814110f2db957dca",
          "score": 0.6289429068565369,
          "text": "List of Back to the Future characters",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a017867fcd778abb9f7425f6c4c502",
          "score": 0.6282395124435425,
          "text": "List of Back to the Future characters\nMartin Seamus \"Marty\" McFly (portrayed by Michael J. Fox in the films and voiced by him in Lego Dimensions, voiced by David Kaufman in the animated series) is the son of George McFly and Lorraine Baines McFly. Marty travels between the past and the future, encountering his ancestors and descendants. Marty and his friend Doc Brown help restore the space-time continuum while encountering Biff Tannen (or members of the Tannen clan) at various points in time.",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a01786849076a2b0f07c0b2057b42f",
          "score": 0.6265469193458557,
          "text": "List of Back to the Future characters\nMaggie McFly is played by Lea Thompson, who also plays Marty's mother Lorraine, even though Maggie is not an ancestor of Lorraine; in a DVD commentary track for Part III, Bob Gale states that the creative team considered it important to include Thompson in the film, and he imagines that McFly men are simply \"genetically predisposed\" to be attracted to women who look like her.",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a0178683e77d3dab88090170085a3a",
          "score": 0.6227892637252808,
          "text": "List of Back to the Future characters\nLinda McFly",
