        },
        {
          "document_id": "01a013ce01de7c5ab7dcccbd1077c9f8",
          "score": 0.5885804891586304,
          "text": "Trịnh Doanh\nDespite the many revolts, Trịnh Doanh defeated them all and passed the rule of Vietnam to his son, Trịnh Sâm.",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013ce021d7b538022c874dae75b8b",
          "score": 0.5831698775291443,
          "text": "Trịnh Doanh\nSee also",
          "source_hops": [
            0
