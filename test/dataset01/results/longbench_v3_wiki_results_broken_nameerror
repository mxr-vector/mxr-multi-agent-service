      "question": "长沙市在交通方面采取了哪些措施来推动城乡融合？",
      "answer_gold_docs": [
        "01a0143dee7e7d14877ea6367b896a64"
      ],
      "bridge_gold_docs": [],
      "hop_gold_docs": [
