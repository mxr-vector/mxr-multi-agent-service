        },
        {
          "document_id": "01a013b3edbc7032a26305db1f0ae0e1",
          "score": 0.7104779481887817,
          "text": "Humphrey de Bohun, 2nd Earl of Hereford\nHumphrey V de Bohun (died 1265), eldest son and heir apparent, who predeceased his father, having shared with him in the victory at the Battle of Evesham (1264), which he did not long survive. The earldom, therefore, passed to his son Humphrey VI de Bohun, 3rd Earl of Hereford, 2nd Earl of Essex (c. 1249 – 1298).",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013b3c4a27e8f81db3239ed39b9ef",
          "score": 0.7082900404930115,
          "text": "John de Bohun, 5th Earl of Hereford\nDeath",
