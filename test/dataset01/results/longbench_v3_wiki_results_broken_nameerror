        {
          "document_id": "01a0177fbc1f7276bd25618fce789f80",
          "score": 0.5129456520080566,
          "text": "Francisco Giner de los Ríos\nSolomon Lipp: Francisco Giner de los Ríos. A Spanish Socrates. Waterloo, Ontario: Wilfried Laurier 1985 ISBN 978-08-89201-59-0",
          "source_hops": [
            0
