      "candidates": [
        {
          "document_id": "01a013d596737f83bffcb97cbb62d775",
          "score": 0.7299684286117554,
          "text": "Teobaldo II Ordelaffi\nTeobaldo II Ordelaffi (also known as Tebaldo, 1413–1425) was briefly lord of Forlì from 1422 to 1424. He was the son of Giorgio Ordelaffi.",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013d596e570e381974e036193cc8d",
          "score": 0.6886903643608093,
          "text": "Teobaldo II Ordelaffi\nWars in Lombardy",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013d596c07662aadb33824ad99d3b",
          "score": 0.6734416484832764,
          "text": "Teobaldo II Ordelaffi\nSee also",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013d59693743781f96a6c80627e86",
          "score": 0.5699998140335083,
          "text": "Teobaldo II Ordelaffi\nGiorgio has named Filippo Maria Visconti of Milan as his trustee, but Teobaldo's mother Lucrezia degli Alidosi, appointed herself as regent. Spurred by Visconti, the Forliveses rebelled and called in the Milanese condottiero Agnolo della Pergola. Florence reacted and, after some initial setbacks, it was joined by Venice in 1425 thanks to the efforts of the Count of Carmagnola. The war moved to Lombardy, and Visconti ceded Forlì and Imola to Pope Martin V. The Ordelaffi would return in Forlì in 1433 with Antonio I.",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013d596087700b85581e5d2444303",
          "score": 0.5581854581832886,
          "text": "Giorgio Ordelaffi\nThe son of Teobaldo Ordelaffi, he married Lucrezia Alidosi of the Alidosi family. He kept the seigniory of Forlì from 1411 until his death, moving his residence in the current Palazzo Comunale.",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013d595ea72a78ad7fc9849f04cfe",
          "score": 0.5375257730484009,
          "text": "Giorgio Ordelaffi\nGiorgio Ordelaffi (died 1423) was lord of Forlì and Papal vicar in Romagna (northern Italy). He was a member of the Ordelaffi family.",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013d5965172389b2462a433b101b7",
          "score": 0.5060594081878662,
          "text": "Teobaldo II Ordelaffi",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013d596327cf58b3aa7d3874713fc",
          "score": 0.5008504986763,
          "text": "Giorgio Ordelaffi\nJust before his death, when his son Teobaldo II Ordelaffi was still young, he offered to Filippo Maria Visconti of Milan the occasion to invade Romagna in 1423, initiating the 30-year long Wars in Lombardy.",
          "source_hops": [
            0
          ]
        },
