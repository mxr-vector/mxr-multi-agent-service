        },
        {
          "document_id": "01a017bbbdb07e0e9fc36bb966edd0d7",
          "score": 0.6690347194671631,
          "text": "The Happy Journey to Trenton and Camden\nPlot summary",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a017bbbce973f4a1e1b77e4ac992a9",
          "score": 0.6231072545051575,
          "text": "The Happy Journey to Trenton and Camden",
          "source_hops": [
            0
