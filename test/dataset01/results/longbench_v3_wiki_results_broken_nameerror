        {
          "document_id": "01a013d8047373b6ae0797f861617a5c",
          "score": 0.6886667013168335,
          "text": "Maurice de Berkeley, 4th Baron Berkeley\nHe was born in Berkeley Castle in Gloucestershire, the eldest son and heir of Thomas de Berkeley, 3rd Baron Berkeley by his wife Lady Margaret Mortimer.",
