        {
          "document_id": "01a013d7dcc27056abc640da706a5efa",
          "score": 0.6514214873313904,
          "text": "Maurice de Berkeley\nSir Maurice de Berkeley \"the Resolute\" (1218 – 4 April 1281), 5th (feudal) Baron de Berkeley, was an English soldier and rebel, residing at Berkeley Castle in the English county of Gloucestershire.",
          "source_hops": [
            0
          ]
        },
        {
          "document_id": "01a013d8025f717a83268fbfe1876435",
          "score": 0.6503428220748901,
          "text": "Henry Berkeley, 7th Baron Berkeley\nHenry Berkeley, 7th Baron Berkeley, KB (26 November 1534 – 26 November 1613) was an English peer and politician. He was Lord Lieutenant and Vice-Admiral of Gloucestershire. He was the grandfather of George Berkeley, 8th Baron Berkeley.",
          "source_hops": [
            0
