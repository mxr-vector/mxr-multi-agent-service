        {
          "document_id": "01a01405df0079b098e4e2de867bb733",
          "score": 0.5669930577278137,
          "text": "Denver Broncos\nThe Denver Broncos are a professional American football franchise based in Denver, Colorado. The Broncos compete in the National Football League (NFL) as a member club of the league's American Football Conference (AFC) West division. The team is headquartered in Dove Valley, Colorado.",
          "source_hops": [
