# .env
# 把 该文件拷贝为 .env.development  / .env.production
APP_ENV=development

API_SECRET_KEY=mxr-multi-agent-service
SERVER_HOST=server_host
SERVER_PORT=8000
BASE_URL=/multi-agent-service

# JWT 登录认证（签名密钥与 API_SECRET_KEY 严格分离，不得复用）
JWT_SECRET_KEY=cG5nF6lA9zV2aT0eG6lP9yC4jD4jE2fG
# token 有效期（小时）
JWT_EXPIRE_HOURS=12

# 文档上传大小上限（MB），超限在解析前即友好拒绝
UPLOAD_MAX_SIZE_MB=50
# 全局上传文件存储根目录（头像等；相对路径基于项目根解析，默认 data）
UPLOAD_DIR=data


# long memory DataBase
POSTGRES_HOST=postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=multi_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Vector DataBase
QDRANT_HOST=qdrant_host
QDRANT_PORT=6333
QDRANT_API_KEY=95279527
# 是否使用 https 连接 Qdrant（服务端未启用 TLS 时保持 false）
QDRANT_HTTPS=false

# embedding model config
# 可选 provider: openai | dashscope | cohere
EMBEDDING_PROVIDER=cohere
# 全局向量模型名称（切换 provider 需同步确认模型一致性）
EMBEDDING_MODEL_NAME=Qwen3-Embedding-4B
EMBEDDING_API_KEY=95279527
# opanai
# EMBEDDING_API_URL=http://embedding_host:9527/v1
# cohere
EMBEDDING_API_URL=http://embedding_host:9527

# ============================================================
# 模型配置与运行参数已迁移至数据库（sys.sys_model_config / sys.sys_config），
# 经配置快照 core.config_snapshot.CFG 读取并支持免重启热更新，在“模型配置”页维护。
# 迁出的键：CHAT_* / REWRITE_* / VISUAL_* / RERANK_* / RAG_* /
#          CHAT_CHECKPOINT_TTL_DAYS / CHAT_HISTORY_MAX_MESSAGES
# seed SQL 由部署者线下自行生成执行（含真实密钥，不随仓库分发），执行后留存作容灾快照。
# ============================================================

# HuggingFace 下载端点（BM25 稀疏模型 Qdrant/bm25 首次下载用）
# 若系统级 HF_ENDPOINT 指向的镜像不可用，在此覆盖为可达的端点（本项目 env 加载时 override=True）
HF_ENDPOINT=https://huggingface.co
# BM25 稀疏模型缓存目录（相对路径基于项目根解析；默认 model/hf，避免 %TEMP% 被系统清理）
BM25_CACHE_DIR=model/hf
