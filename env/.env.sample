# .env
# 把 该文件拷贝为 .env.development  / .env.production
APP_ENV=development

API_SECRET_KEY=MXR-MULTI-AGENT-SERVICE
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
BASE_URL=/multi-agent-base


# long memory DataBase
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=multi_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Vector DataBase
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=95279527
# 是否使用 https 连接 Qdrant（服务端未启用 TLS 时保持 false）
QDRANT_HTTPS=false

# embedding model config
# 可选 provider: openai | dashscope | cohere
EMBEDDING_PROVIDER=cohere
# 全局向量模型名称（切换 provider 需同步确认模型一致性）
EMBEDDING_MODEL_NAME=Qwen3-Embedding-0.6B
EMBEDDING_API_KEY=95279527
# opanai
# EMBEDDING_API_URL=http://127.0.0.1:9527/v1
# cohere
EMBEDDING_API_URL=http://127.0.0.1:9527

# rerank model (vLLM cohere 兼容接口)
# 可选 provider: cohere
RERANK_PROVIDER=cohere
RERANK_MODEL_NAME=Qwen3-Embedding-0.6B
RERANK_API_KEY=95279527
RERANK_API_URL=http://127.0.0.1:9527

# chat model config (vLLM OpenAI 兼容接口)
CHAT_MODEL_NAME=Qwen3-8B
CHAT_API_KEY=95279527
CHAT_API_URL=http://127.0.0.1:9527/v1

# rewrite or compression model  (vLLM OpenAI 兼容接口)
REWRITE_MODEL_NAME=Qwen3-8B
REWRITE_API_KEY=95279527
REWRITE_API_URL=http://127.0.0.1:9527/v1

# RAG 混合检索配置
# 混合召回（dense + sparse，服务端 RRF 融合）后保留的候选池大小
RAG_CANDIDATE_POOL_SIZE=20
# 重排序后保留的最终候选数量（top-k）
RAG_FINAL_TOP_K=5
# 反思循环最大检索轮数上限
RAG_REFLECT_ROUND_CAP=3


