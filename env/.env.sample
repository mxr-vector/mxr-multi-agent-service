# .env
# 把 该文件拷贝为 .env.development  / .env.production
APP_ENV=development

API_SECRET_KEY=MXR-MULTI-AGENT-SERVICE
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
BASE_URL=/multi-agent-base


# long memory DataBase
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=multi_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Vector DataBase
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=95279527
# 是否使用 https 连接 Qdrant（服务端未启用 TLS 时保持 false）
QDRANT_HTTPS=false

# embedding model config
# 可选 provider: openai | dashscope | cohere
EMBEDDING_PROVIDER=openai
# 全局向量模型名称（切换 provider 需同步确认模型一致性）
EMBEDDING_MODEL_NAME=Qwen3-Embedding-0.6B
EMBEDDING_API_KEY=123456
# opanai
EMBEDDING_API_URL=http://127.0.0.1:8001/v1
# cohere
# EMBEDDING_API_URL=http://127.0.0.1:8001

# chat model config (vLLM OpenAI 兼容接口)
CHAT_MODEL_NAME=Qwen3-8B
CHAT_API_KEY=123456
CHAT_API_URL=http://127.0.0.1:8000/v1
